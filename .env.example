# `bin/setup` がホストの UID/GID とランダムなローカル開発用認証情報を .env に保存します。
COMPOSE_PROJECT_NAME=elixir_phoenix_dev
APP_UID=1000
APP_GID=1000
PHX_PORT=4000
PHX_NEW_VERSION=1.8.16
ELIXIR_IMAGE=elixir:1.19.5-otp-28-slim
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=replace_with_random_local_password
ERLANG_COOKIE=replace_with_random_local_cookie
LIVEBOOK_PORT=8080
LIVEBOOK_IFRAME_PORT=8081
